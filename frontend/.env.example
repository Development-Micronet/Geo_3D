# Copy to .env and adjust as needed.

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# Optional: ArcGIS API Key (Not required for local .slpk / I3S rendering or open basemaps)
# Only needed if you choose to enable premium ArcGIS Online basemaps or geocoding services.
VITE_ARCGIS_API_KEY=

# Optional: Cesium ion access token (only needed if Cesium World Terrain is enabled)
VITE_CESIUM_ION_TOKEN=
